# Provider keys (never in YAML, traces, cache keys or exports)
TOGETHER_API_KEY=your_together_key_here
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# Sign-in gate for the browser UI (python main.py serve). A shared pilot
# password, hashed with PBKDF2 before comparison. A built-in default is used
# when this is unset and the console says so; set it before exposing the server.
HARNESS_PILOT_PASSWORD=
